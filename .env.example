DATABASE_URL=postgresql+psycopg://fish_app:CHANGE_ME@localhost:5432/fish_distribution

# development or production. Production turns off /docs and /openapi.json.
APP_ENV=development

# Exact origins allowed to call the API. No wildcards.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie settings. Secure must be true in production (https only).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax